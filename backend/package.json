{
  "name": "ticketflow-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate dev --name init",
    "lint": "node --check src/app.js && node --check src/server.js && node --check src/domain/bookingStatus.js && node --check src/domain/pricing.js && node --check src/domain/refundPolicy.js",
    "db:seed": "node prisma/seed.js",
    "build": "node --check src/app.js && node --check src/server.js"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^2.1.8",
    "nodemon": "^3.1.7",
    "prisma": "^6.19.0",
    "supertest": "^7.0.0",
    "vitest": "^2.1.8"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  }
}
